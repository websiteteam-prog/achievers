# =====================================================================
#  Campaign Registration - settings
#  Copy this file to ".env" (same folder) and fill in the values.
#  .env holds passwords and API keys: never share it or commit it.
#  It is blocked from the browser by .htaccess.
# =====================================================================

# ---------------------------------------------------------------- App
# production on the live server, local on your own computer (shows PHP errors)
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
# Long random string used to hash OTPs (at least 32 characters).
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
# true = IMEI must pass the IMEI check-digit test (recommended)
IMEI_LUHN_CHECK=true
# Leave empty unless the site is behind Cloudflare / a load balancer.
# Cloudflare: HTTP_CF_CONNECTING_IP   Other proxy: HTTP_X_FORWARDED_FOR
CLIENT_IP_HEADER=

# ----------------------------------------------------------- Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campaign_registration
DB_USER=
DB_PASS=

# ---------------------------------------------------------------- OTP
# auto = DEV OTP while SMS_API_URL is empty; real SMS as soon as SMS_API_URL is set
# dev  = always DEV OTP (no SMS is sent)
# live = always real SMS
OTP_MODE=auto
# The OTP that works in dev mode (shown on the form). Not used once live SMS is on.
DEV_OTP=123456
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30

# ------------------------------------------- uEngage SMS + Airtel DLT
# Copy every value from your uEngage API document / panel and the DLT portal.
# Leaving SMS_API_URL empty keeps the DEV OTP active (OTP_MODE=auto).

# Send-SMS API URL from the uEngage document
SMS_API_URL=
# GET or POST
SMS_METHOD=GET
# For POST only: form or json
SMS_POST_FORMAT=form
SMS_TIMEOUT=15
# Login parameters exactly as uEngage names them, in query format:
#   SMS_AUTH_PARAMS="apikey=YOUR_KEY"   or   SMS_AUTH_PARAMS="username=abc&password=xyz"
SMS_AUTH_PARAMS=
# Extra HTTP headers if uEngage uses header auth (separate several with ||)
#   SMS_HEADERS="Authorization: Bearer YOUR_TOKEN"
SMS_HEADERS=

# Airtel DLT values
# Approved 6-character Sender ID / Header
SMS_SENDER_ID=
# DLT Content Template ID of the approved OTP template
SMS_TEMPLATE_ID=
# Principal Entity ID
SMS_PE_ID=
# Approved OTP template copied EXACTLY, with {#var#} where the variables go
SMS_MESSAGE_TEMPLATE=""
# What fills each {#var#}, in order: otp, expiry_minutes (or fixed text)
SMS_TEMPLATE_VARS=otp

# Request parameter names exactly as written in the uEngage API document.
# Write none for sender / template / PE ID only if uEngage says not to send it.
SMS_PARAM_MOBILE=
SMS_PARAM_MESSAGE=
SMS_PARAM_SENDER_ID=
SMS_PARAM_TEMPLATE_ID=
SMS_PARAM_PE_ID=
# Any other fixed parameters the document requires, query format:
#   SMS_EXTRA_PARAMS="route=transactional&type=TXN"
SMS_EXTRA_PARAMS=
# 91 if uEngage wants 91XXXXXXXXXX, none if it wants only 10 digits
SMS_MOBILE_PREFIX=91
# Text that appears in uEngage's response when the SMS is accepted
# (leave empty to accept any HTTP 200 response)
SMS_SUCCESS_MATCH=

# -------------------------------------------------------------- Admin
# Auto logout after this many seconds of inactivity
ADMIN_SESSION_TIMEOUT=1800
