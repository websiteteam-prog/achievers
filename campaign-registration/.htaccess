# Campaign Registration - Apache rules
Options -Indexes
DirectoryIndex index.php

# Block hidden files (.env holds the database and SMS passwords, .htaccess, .git...)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block project files that are not meant for browsers
<FilesMatch "(?i)\.(sql|md|lock|log|json|ini|sh|bak|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# includes/, storage/, vendor/ and admin/partials/ each have their own "deny all" .htaccess.
