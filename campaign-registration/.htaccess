# Campaign Registration - Apache rules
Options -Indexes
DirectoryIndex index.php

# Block project files that are not meant for browsers
<FilesMatch "(?i)\.(sql|md|lock|log|json|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# config/, includes/, storage/ and vendor/ each have their own "deny all" .htaccess.
